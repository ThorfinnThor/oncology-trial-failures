{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "npm run data:optimize",
    "dev": "next dev",
    "data:optimize": "node scripts/generate-data-shards.mjs",
    "build": "npm run data:optimize && next build",
    "cf:build": "npm run data:optimize && opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:preview": "npm run cf:build && wrangler dev",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-virtual": "^3.11.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.1.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "wrangler": "^4.125.0"
  }
}
