{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "npm run data:optimize",
    "dev": "next dev",
    "data:optimize": "node scripts/generate-data-shards.mjs",
    "build": "npm run data:optimize && next build",
    "build:cloudflare": "npm run data:optimize && next build --webpack",
    "cloudflare:build": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs",
    "cloudflare:preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "cloudflare:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "wrangler": "4.125.0"
  }
}
