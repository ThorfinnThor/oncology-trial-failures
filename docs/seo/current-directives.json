      "sitemap": "included when buildFailureHubs() produces the hub",
      "decisionOwner": "template; no registry override"
    },
    {
      "pattern": "/sponsor/[slug]",
      "robots": "index,follow",
      "canonical": "https://clinicaltrialfailures.com/sponsor/{slug}",
      "sitemap": "included when buildSponsorHubs() produces the sponsor",
      "decisionOwner": "template; no registry override"
    },
    {
      "pattern": "/trial/[trialId]",
      "robots": "index,follow when isIndexableTrial(row); otherwise noindex,follow",
      "canonical": "generated trialPath(row)",
      "sitemap": "included when indexableTrialRows(rows) contains the row",
      "decisionOwner": "classification predicate; no registry override"
    },
    {
      "pattern": "/compare",
      "robots": "noindex,follow",
      "canonical": "self",
      "sitemap": "excluded",
      "decisionOwner": "page template"
    },
    {
      "pattern": "/access and newsletter confirmation/stop flows",
      "robots": "noindex or noindex,nofollow",
      "canonical": "page-specific",
      "sitemap": "excluded",
      "decisionOwner": "transaction/account templates"
    }
  ],
  "limitations": [
