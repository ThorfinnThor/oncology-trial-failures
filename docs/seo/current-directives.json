{
  "snapshotDate": "2026-10-09",
  "sourceFiles": {
    "trial": "web/pages/trial/[trialId].tsx",
    "trialPredicate": "web/lib/seoHubs.ts:isIndexableTrial",
    "staticPolicy": "web/lib/seoStaticPolicy.ts",
    "failureHub": "web/components/SeoHubPage.tsx",
    "sponsorHub": "web/components/SponsorEvidencePage.tsx",
    "sitemap": "web/pages/sitemap.xml.tsx",
    "robots": "web/pages/robots.txt.tsx",
    "redirects": "web/next.config.ts"
  },
  "directives": [
    {
      "pattern": "/failures/[slug]",
      "robots": "index,follow",
      "canonical": "https://clinicaltrialfailures.com/failures/{slug}",
      "sitemap": "included when buildFailureHubs() produces the hub",
      "decisionOwner": "template; no registry override"
    },
    {
      "pattern": "/sponsor/[slug]",
      "robots": "index,follow",
      "canonical": "https://clinicaltrialfailures.com/sponsor/{slug}",
      "sitemap": "included when buildSponsorHubs() produces the sponsor",
      "decisionOwner": "template; no registry override"
    },
    {
      "pattern": "/trial/[trialId]",
      "robots": "index,follow only when the biological-signal predicate and source-backed search-evidence gate both pass; otherwise noindex,follow",
      "canonical": "generated trialPath(row)",
      "sitemap": "included when indexableTrialRows(rows) contains the row",
      "decisionOwner": "classification plus evidence predicate; reviewed URL decisions remain separate"
    },
    {
      "pattern": "/explore, /asset-check, /newsletter, /contact",
      "robots": "noindex,follow",
      "canonical": "self",
      "sitemap": "excluded",
      "decisionOwner": "reviewed static utility policy"
    },
    {
      "pattern": "/sponsor-insights",
      "robots": "noindex,follow",
      "canonical": "self",
      "sitemap": "excluded",
      "decisionOwner": "reviewed static thin-content policy"
    },
    {
      "pattern": "/compare",
      "robots": "noindex,follow",
      "canonical": "self",
      "sitemap": "excluded",
      "decisionOwner": "page template"
    },
    {
      "pattern": "/access and newsletter confirmation/stop flows",
      "robots": "noindex or noindex,nofollow",
      "canonical": "page-specific",
      "sitemap": "excluded",
      "decisionOwner": "transaction/account templates"
    }
  ],
  "limitations": [
    "The static policy is deliberately limited to the five reviewed paths listed above.",
    "Google-selected canonicals and actual index status are separate measurement fields.",
    "No broad or pattern-based mass deindexing is authorized by this file."
  ]
}
